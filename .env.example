# NEXUS Code - API Keys Configuration
# Copy this to .env and add your keys

# Anthropic (Claude) - Required for Claude models
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI - Required for GPT models and image generation
OPENAI_API_KEY=sk-...

# Google (Gemini) - Required for Gemini models
GOOGLE_API_KEY=...

# At least ONE API key is required to run NEXUS
# Multiple keys enable cross-provider features (e.g., Claude -> OpenAI image generation)
