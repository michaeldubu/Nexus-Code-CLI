    def __init__(self):
        super().__init__()
        
        # Initialize NEXUS CODE components
        self.config = NexusCodeConfig()
        self.ai_client = AIProviderClient(self.config)
        self.mcp_manager = MCPManager(self.config)
        self.orchestrator = AgentOrchestrator(self.config, self.ai_client, self.mcp_manager)
        self.project_manager = ProjectManager(self.config)
        
        # TUI state
        self.current_project_obj = None
        self.agent_outputs = {}
        self.mcp_servers_status = {}
        self.hot_reload_server = None
        self.live_preview_server = None
        self.collaboration_sessions = {}
        
        # Performance monitoring
        self.performance_stats = {
            "cpu_usage": 0.0,
            "memory_usage": 0.0,
            "active_tasks": 0,
            "completed_tasks": 0
        }
        
    def compose(self) -> ComposeResult:
        """Compose the revolutionary TUI interface"""
        
        # Header with dynamic branding
        header_content = f"NEXUS CODE | SAAAM Intelligence | {datetime.now().strftime('%H:%M:%S')}"
        yield Header(show_clock=True, name="nexus_header", classes="nexus-header")
        
        with Container(id="main_container"):
            with Horizontal():
                # Left Sidebar - Project & Agent Management
                with Vertical(classes="nexus-sidebar", id="sidebar"):
                    yield Static("PROJECT CONTROL", classes="nexus-status")
                    yield Button("New Project", id="btn_new_project", classes="nexus-button")
                    yield Button("Open Project", id="btn_open_project", classes="nexus-button")
                    yield Button("Save Project", id="btn_save_project", classes="nexus-button")
                    
                    yield Static("AGENT ORCHESTRATION", classes="nexus-status")
                    yield Button("Activate All Agents", id="btn_activate_agents", classes="nexus-button")
                    yield Button("Thinking Mode", id="btn_thinking_mode", classes="nexus-button")
                    yield Button("Agent Handoff", id="btn_agent_handoff", classes="nexus-button")
                    
                    yield Static("MCP SERVERS", classes="nexus-status")
                    yield Button("Connect Servers", id="btn_connect_mcp", classes="nexus-button")
                    yield Button("Discover Tools", id="btn_discover_tools", classes="nexus-button")
                    
                    yield Static("DEVELOPMENT", classes="nexus-status")
                    yield Button("Hot Reload", id="btn_hot_reload", classes="nexus-button")
                    yield Button("Live Preview", id="btn_live_preview", classes="nexus-button")
                    yield Button("Deploy", id="btn_deploy", classes="nexus-button")
                
                # Main Content Area
                with Vertical(classes="nexus-main", id="main_area"):
                    with TabbedContent(initial="code"):
                        # Code Editor Tab
                        with TabPane("Code Editor", id="code"):
                            with Vertical():
                                yield TextArea(
                                    placeholder="NEXUS CODE!",
                                    id="code_editor",
                                    classes="nexus-input"
                                )
                        
                        # AI Collaboration Tab  
                        with TabPane("AI Collaboration", id="ai_collab"):
                            with Vertical():
                                yield Static("Multi-Agent AI Collaboration", classes="nexus-status")
                                yield RichLog(id="ai_chat", classes="nexus-output")
                                yield Input(
                                    placeholder="Chat with agents...",
                                    id="ai_input",
                                    classes="nexus-input"
                                )
                        
                        # Project Files Tab
                        with TabPane("Files", id="files"):
                            yield DirectoryTree(
                                "/home/claude",
                                id="file_tree",
                                classes="nexus-main"
                            )
                        
                        # Live Preview Tab
                        with TabPane("Live Preview", id="preview"):
                            yield Static("Live Preview Server", classes="live-preview")
                            yield RichLog(id="preview_log", classes="nexus-output")
                        
                        # Agent Dashboard Tab
                        with TabPane("Agents", id="agents"):
                            yield Static("Agent Dashboard", classes="nexus-status")
                            with Horizontal():
                                yield Static("ARCHITECT", classes="agent-active", id="agent_architect")
                                yield Static("DEVELOPER", classes="agent-idle", id="agent_developer") 
                                yield Static("REVIEWER", classes="agent-thinking", id="agent_reviewer")
                            yield RichLog(id="agent_logs", classes="nexus-output")
                        
                        # MCP Tools Tab
                        with TabPane("MCP Tools", id="mcp_tools"):
                            yield Static("Model Context Protocol Tools", classes="nexus-status")
                            yield DataTable(id="mcp_table", classes="mcp-server")
                        
                        # Performance Tab
                        with TabPane("Performance", id="performance"):
                            yield Static("System Performance", classes="nexus-status")
                            yield Sparkline(id="cpu_sparkline", classes="ai-model-indicator")
                            yield Sparkline(id="memory_sparkline", classes="hot-reload-indicator")
                            yield RichLog(id="performance_log", classes="nexus-output")
            
            # Bottom Status Bar
            with Container(classes="nexus-status", id="status_bar"):
                with Horizontal():
                    yield Static("🎯", id="project_indicator", classes="project-active")
                    yield Static("🤖", id="agent_indicator", classes="agent-active")
                    yield Static("🔥", id="hot_reload_indicator", classes="hot-reload-indicator")
                    yield Static("👁️", id="preview_indicator", classes="live-preview")
                    yield Static("🔌", id="mcp_indicator", classes="mcp-server")
                    yield Static("⚡", id="performance_indicator", classes="ai-model-indicator")
        
        yield Footer()
    
    async def on_mount(self) -> None:
        """Initialize the revolutionary NEXUS CODE environment"""
        self.log("NEXUS Initializing...")
        
        # Initialize core systems
        await self._initialize_systems()
        
        # Setup live updates
        self._setup_live_updates()
        
        # Start performance monitoring
        self._start_performance_monitoring()
        
        # Welcome message
        self.display_welcome_message()
        
        self.log("NEXUS CODE Ready!")
    
    async def _initialize_systems(self):
        """Initialize all NEXUS CODE systems"""
        try:
            # Initialize MCP servers
            await self.mcp_manager.initialize()
            
            # Setup AI clients
            self.log("AI Providers initialized")
            
            # Initialize agent orchestrator
            self.log("Agent Orchestrator ready")
            
            # Setup project manager
            self.log("Project Manager initialized")
            
        except Exception as e:
            self.log(f"Initialization error: {e}")
            logger.error(f"TUI initialization failed: {e}")
    
    def _setup_live_updates(self):
        """Setup live updates for reactive interface"""
        
        # Update status indicators every second
        self.set_interval(1.0, self._update_status_indicators)
        
        # Update performance metrics every 2 seconds
        self.set_interval(2.0, self._update_performance_metrics)
        
        # Update agent status every 3 seconds
        self.set_interval(3.0, self._update_agent_status)
        
        # Hot reload check every 500ms
        self.set_interval(0.5, self._check_hot_reload)
    
    def _start_performance_monitoring(self):
        """Start system performance monitoring"""
        def monitor_performance():
            while True:
                try:
                    self.performance_stats["cpu_usage"] = psutil.cpu_percent()
                    self.performance_stats["memory_usage"] = psutil.virtual_memory().percent
                    
                    time.sleep(2)
                except Exception as e:
                    logger.error(f"Performance monitoring error: {e}")
        
        threading.Thread(target=monitor_performance, daemon=True).start()
    
